# macOS / editor / sync metadata
.DS_Store
._*
*.swp
*.swo
*.tmp
*.bak
*.rsls
.~*

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Virtual environments and local secrets
.venv/
venv/
env/
.env
.env.*
configs/local/*.yaml
configs/local/*.yml

# Jupyter
.ipynb_checkpoints/

# Notebook working directories are not data stores; fail safe if an export
# accidentally lands here instead of in the repository-root data/ tree.
/notebooks/data/

# Generated data: keep directory placeholders and README files only
data/**/*.csv
data/**/*.tsv
data/**/*.txt
data/**/*.json
data/**/*.jsonl
data/**/*.yaml
data/**/*.yml
data/**/*.parquet
data/**/*.feather
data/**/*.xlsx
data/**/*.pkl
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
data/**/*.pdf
data/**/*.html
data/**/*.svg
!data/**/README.md
!data/**/.gitkeep

# Generated reports and plot artifacts
data/05_plots/**/*.png
reports/
*.pdf

# Local scratch outputs
archive/scratch/*
!archive/scratch/README.md
